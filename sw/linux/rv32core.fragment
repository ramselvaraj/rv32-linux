# RV32IMA only: no compressed, no FPU, no vector, no Zicbom; SBI timer/console from OpenSBI.
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NET is not set
# CONFIG_BLK_DEV is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_RISCV_SBI=y
# CONFIG_RISCV_SBI_V01 is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_CMDLINE="console=ttyS0,115200 earlycon=sbi"
# CONFIG_EFI is not set
# Trim the stock rv32 defconfig down to what this SoC has.
# CONFIG_IIO is not set
# CONFIG_HWMON is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PCI is not set
# CONFIG_MMC is not set
# CONFIG_NVME_CORE is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_INPUT is not set
# CONFIG_VT is not set
# CONFIG_FB is not set
# CONFIG_WATCHDOG is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_THERMAL is not set
# CONFIG_HID is not set
# CONFIG_KVM is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_FTRACE is not set
# CONFIG_SECURITY is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_USB is not set
# CONFIG_PM is not set
# CONFIG_CPU_IDLE is not set
